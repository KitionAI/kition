{
  "$comment": "Kit engines, built into each kit's package public/kits/<kit>-ui/engine by scripts/build-kit-ui.sh, and how scripts/check-kit-sdk.mjs checks each one (docs/kit-sdk.md). `kition: true` builds from a Kition checkout too (the table kit's editor is Kition's own); `path` is a kit that lives in Kition (the board and document kits, built from that folder; `runtime: ts-worker`, a TypeScript engine that scripts/check-kit-sdk.mjs leaves to check-manifest --module); `optional: true` may be left out of kits/kits.lock.json (Kition does not ship it until it is pinned).",
  "photo": {
    "repository": "KitionAI/kition-photo",
    "crate": "kition-photo-sdk",
    "module": "kition_photo_sdk",
    "class": "PhotoDocument",
    "name": "fixture.psd",
    "edit": {
      "command": "paint.stroke",
      "params": {
        "points": [
          [
            4,
            4,
            1
          ],
          [
            30,
            20,
            1
          ]
        ],
        "size": 6,
        "color": "#ff0000"
      }
    }
  },
  "film": {
    "repository": "KitionAI/kition-film",
    "crate": "kition-film-sdk",
    "module": "kition_film_sdk",
    "class": "FilmDocument",
    "name": "Edit.kitionfilm",
    "edit": [
      {
        "command": "file.newColorMatte",
        "params": {
          "color": "#ff0000",
          "seconds": 2
        }
      },
      {
        "command": "timeline.place",
        "params": {
          "item": "$0.item",
          "track": "V1",
          "seconds": 0
        }
      }
    ]
  },
  "vector": {
    "repository": "KitionAI/kition-vector",
    "crate": "kition-vector-sdk",
    "module": "kition_vector_sdk",
    "class": "VectorDocument",
    "name": "Drawing.kitionvector",
    "edit": {
      "command": "shape.rectangle",
      "params": {
        "x": 20,
        "y": 10,
        "width": 50,
        "height": 30
      }
    }
  },
  "effect": {
    "repository": "KitionAI/kition-effect",
    "crate": "kition-effect-sdk",
    "module": "kition_effect_sdk",
    "class": "EffectDocument",
    "name": "Motion.kitioneffect",
    "edit": {
      "command": "layer.newSolid",
      "params": {
        "name": "Red",
        "color": "#ff0000"
      }
    }
  },
  "design": {
    "repository": "KitionAI/kition-design",
    "crate": "kition-design-sdk",
    "module": "kition_design_sdk",
    "class": "DesignDocument",
    "name": "Flyer.kitiondesign",
    "edit": [
      {
        "command": "frame.create",
        "params": {
          "rect": [
            10,
            10,
            40,
            30
          ],
          "content": "unassigned"
        }
      },
      {
        "command": "object.fill",
        "params": {
          "swatch": "Black",
          "ids": [
            "$0.id"
          ]
        }
      }
    ]
  },
  "cad": {
    "repository": "KitionAI/kition-cad",
    "crate": "kition-cad-sdk",
    "module": "kition_cad_sdk",
    "class": "CadDocument",
    "name": "Plan.dxf",
    "edit": {
      "command": "circle",
      "params": {
        "center": [
          200,
          150
        ],
        "radius": 40
      }
    }
  },
  "slide": {
    "repository": "KitionAI/kition-slide",
    "crate": "kition-slide-sdk",
    "module": "kition_slide_sdk",
    "class": "SlideDocument",
    "name": "Slide.kitionslide",
    "edit": {
      "command": "shape.insert",
      "params": {
        "preset": "ellipse",
        "rect": [
          100,
          100,
          200,
          120
        ]
      }
    }
  },
  "word": {
    "repository": "KitionAI/kition-word",
    "crate": "kition-word-sdk",
    "module": "kition_word_sdk",
    "class": "WordDocument",
    "name": "Letter.docx",
    "edit": {
      "command": "text.insert",
      "params": {
        "text": "Hello"
      }
    }
  },
  "sheet": {
    "repository": "KitionAI/kition-sheet",
    "crate": "kition-sheet-sdk",
    "module": "kition_sheet_sdk",
    "class": "SheetDocument",
    "name": "Budget.xlsx",
    "edit": {
      "command": "cell.set",
      "params": {
        "cell": "C2",
        "input": "99"
      }
    }
  },
  "pdf": {
    "repository": "KitionAI/kition-pdf",
    "crate": "kition-pdf-sdk",
    "module": "kition_pdf_sdk",
    "class": "PdfDocument",
    "name": "Report.pdf",
    "edit": {
      "command": "page_rotate",
      "params": {
        "degrees": 90,
        "pages": [
          1
        ]
      }
    }
  },
  "table": {
    "repository": "KitionAI/kition-table",
    "crate": "kition-table-sdk",
    "module": "kition_table_sdk",
    "class": "TableDocument",
    "name": "Tasks.kitable",
    "kition": true,
    "optional": true,
    "edit": {
      "command": "table.records.create",
      "params": {
        "tableId": 1,
        "values": {
          "title": "Write the plan"
        }
      }
    }
  },
  "board": {
    "repository": "KitionAI/kition",
    "path": "packages/board-kit",
    "module": "kition_board_engine",
    "class": "BoardDocument",
    "runtime": "ts-worker",
    "name": "Plan.kiboard",
    "kition": true,
    "optional": true,
    "edit": {
      "command": "element.create",
      "params": {
        "elements": [
          {
            "id": "note-1",
            "kind": "rectangle",
            "x": 0,
            "y": 0,
            "width": 160,
            "height": 100,
            "text": "Plan",
            "shapeType": "rectangle"
          }
        ]
      }
    }
  },
  "document": {
    "repository": "KitionAI/kition",
    "path": "packages/document-kit",
    "module": "kition_document_engine",
    "class": "MarkdownDocument",
    "runtime": "ts-worker",
    "name": "Notes.md",
    "kition": true,
    "optional": true,
    "edit": {
      "command": "text.insert",
      "params": { "at": 0, "text": "# Notes\n" }
    }
  }
}
