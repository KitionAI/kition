{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kition",
  "mainBinaryName": "Kition",
  "version": "../package.json",
  "identifier": "com.kition.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "pnpm exec vite --config tooling/vite.config.ts --host 127.0.0.1 --port 3000 --strictPort",
      "cwd": ".."
    }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "publisher": "Heartie Technology Limited",
    "copyright": "Copyright © 2026 Heartie Technology Limited",
    "category": "Productivity",
    "shortDescription": "Documents, tables, AI agents, and workflows",
    "longDescription": "Kition — documents, structured tables, AI agents, and visual workflows in one workspace.",
    "homepage": "https://kition.ai",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE.kition.txt",
      "../docs/legal/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "../build/entitlements.mac.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kition"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
