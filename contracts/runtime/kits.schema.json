{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kition.ai/contracts/runtime/kits.schema.json",
  "title": "Kition Kits",
  "description": "GET /v1/kits, POST /v1/kits/documents, and /v1/kits/{kitId}/documents/{documentId}[/commands|/save|/preview]. JSON answers use the runtime envelope; /preview answers image/png. Errors carry data.reason: not_installed, stopped, or a Kit Protocol reason such as document_not_found.",
  "$ref": "#/$defs/kitList",
  "$defs": {
    "kitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "kitStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "extensions",
        "creates",
        "installed",
        "embeddable",
        "binaryEnv"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kitId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          }
        },
        "creates": {
          "type": "array",
          "description": "Extensions the kit can create new documents in.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          }
        },
        "installed": {
          "type": "boolean"
        },
        "embeddable": {
          "type": "boolean",
          "description": "Kit tabs can show the kit's own editor here: the desktop app on a supported system."
        },
        "binaryEnv": {
          "type": "string",
          "description": "Environment variable that points at a local build of the kit executable."
        }
      }
    },
    "kitList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kits"
      ],
      "properties": {
        "kits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/kitStatus"
          }
        }
      }
    },
    "openRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        }
      }
    },
    "surfaceRect": {
      "type": "object",
      "additionalProperties": false,
      "description": "Logical pixels relative to the top-left of the window's web content.",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "openSurfaceRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "POST /v1/kits/surfaces: opens the file in the kit's own editor, kept over `rect`.",
      "required": [
        "path",
        "rect"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "rect": {
          "$ref": "#/$defs/surfaceRect"
        },
        "visible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "surfaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "document"
      ],
      "properties": {
        "surfaceId": {
          "type": "integer",
          "minimum": 1
        },
        "document": {
          "$ref": "#/$defs/documentView"
        }
      }
    },
    "updateSurfaceRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "PUT /v1/kits/surfaces/{surfaceId}. DELETE on the same path closes the editor.",
      "properties": {
        "rect": {
          "$ref": "#/$defs/surfaceRect"
        },
        "visible": {
          "type": "boolean"
        }
      }
    },
    "commandView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "group",
        "mutates",
        "enabled",
        "menu",
        "shortcut"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "type": "string"
        },
        "mutates": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "menu": {
          "type": "array",
          "description": "Menu path in the kit, for example [\"Layer\", \"New\"]; empty when the command is not in a menu.",
          "items": {
            "type": "string"
          }
        },
        "shortcut": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "commandList": {
      "type": "object",
      "additionalProperties": false,
      "description": "GET /v1/kits/{kitId}/documents/{documentId}/commands[?query=]",
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commandView"
          }
        }
      }
    },
    "writeFileQuery": {
      "type": "object",
      "additionalProperties": false,
      "description": "PUT /v1/kits/files?path=: replaces a workspace file a kit edits with the raw request body (application/octet-stream, up to 2 GiB), or writes a kit export (for example an .mp4 from a video project) as a new file; an export never replaces an existing file. In-page editors save and export through it.",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "POST /v1/kits/documents/new: creates an `Untitled image` file in the folder and opens it.",
      "properties": {
        "folder": {
          "type": "string",
          "description": "Workspace-relative folder; empty for the workspace root."
        },
        "extension": {
          "type": "string",
          "pattern": "^[a-z0-9]+$",
          "default": "psd"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000,
          "default": 1920
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000,
          "default": 1080
        }
      }
    },
    "documentView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kitId",
        "documentId",
        "path",
        "title",
        "format",
        "readOnly",
        "dirty",
        "canUndo",
        "canRedo",
        "version",
        "summary",
        "details"
      ],
      "properties": {
        "kitId": {
          "$ref": "#/$defs/kitId"
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "description": "Workspace-relative path; null until the document is saved.",
          "anyOf": [
            {
              "$ref": "#/$defs/workspacePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "dirty": {
          "type": "boolean"
        },
        "canUndo": {
          "type": "boolean"
        },
        "canRedo": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "description": "Increments whenever the kit reports a change, including agent edits."
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "description": "Kit-defined structure from view.describe. kit.photo reports width, height, mode, depth, and layers.",
          "additionalProperties": true
        }
      }
    },
    "photoLayer": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "visible"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "type": [
            "number",
            "null"
          ]
        },
        "blend": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected": {
          "type": "boolean"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "Nesting inside groups; 0 at the top level."
        }
      }
    },
    "photoColor": {
      "type": "array",
      "description": "RGBA, each 0 to 1.",
      "items": {
        "type": "number"
      }
    },
    "photoDetails": {
      "type": "object",
      "required": [
        "width",
        "height",
        "mode",
        "depth",
        "layers"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string"
        },
        "depth": {
          "type": "integer"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/photoLayer"
          }
        },
        "activeLayer": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "description": "The embedded editor's active tool, for example Brush."
        },
        "brushSize": {
          "type": [
            "number",
            "null"
          ]
        },
        "zoom": {
          "type": [
            "number",
            "null"
          ],
          "description": "1 is 100%."
        },
        "foreground": {
          "anyOf": [
            {
              "$ref": "#/$defs/photoColor"
            },
            {
              "type": "null"
            }
          ]
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/photoColor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "executeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "executeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "result",
        "document"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "result": {},
        "document": {
          "$ref": "#/$defs/documentView"
        }
      }
    },
    "bridgeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kit",
        "dirty",
        "revision"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "kit": {
          "$ref": "#/$defs/kitId"
        },
        "dirty": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "A document open in a kit editor in the renderer (Kit AI bridge, kit/documents)."
    },
    "bridgeDocumentsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bridgeDocument"
          }
        }
      }
    },
    "bridgeCallParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kit",
        "tool",
        "arguments"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "kit": {
          "$ref": "#/$defs/kitId"
        },
        "tool": {
          "enum": [
            "inspect",
            "commands",
            "run",
            "draft_ready",
            "draft_reopen"
          ]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "description": "kit/call: one of the kit's document tools on the live document. `commands` takes {query}; `run` takes {steps: [{command, params?}], save, draft?}; `inspect` takes {draft?}. With `draft: true` they work on the agent's draft of the document (Kit Standard 2.0 A12); `draft_ready` and `draft_reopen` take {} and answer the draft's {state, revision}. Merging and discarding a draft are the person's, never a bridge call."
    },
    "bridgeLiveDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "summary",
        "dirty",
        "canUndo",
        "canRedo",
        "details"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "summary": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "canUndo": {
          "type": "boolean"
        },
        "canRedo": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": true,
          "description": "The kit engine's inspect() JSON."
        },
        "draft": {
          "$ref": "#/$defs/bridgeDraftInfo"
        }
      }
    },
    "bridgeDraftInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "revision"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "open",
            "ready"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "description": "The agent's draft of a kit document (Kit UI protocol section 7d): `open` while the agent works on it, `ready` once it asks for review."
    },
    "bridgeInspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document"
      ],
      "properties": {
        "document": {
          "$ref": "#/$defs/bridgeLiveDocument"
        }
      }
    },
    "bridgeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "enabled",
        "mutates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "mutates": {
          "type": "boolean"
        }
      }
    },
    "bridgeCommandsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "total"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bridgeCommand"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bridgeRunStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "changed",
        "result"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "changed": {
          "type": "boolean"
        },
        "result": {
          "description": "The command's JSON result."
        }
      }
    },
    "bridgeRunResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "saved",
        "document"
      ],
      "properties": {
        "completed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bridgeRunStep"
          }
        },
        "saved": {
          "type": "boolean"
        },
        "document": {
          "$ref": "#/$defs/bridgeLiveDocument"
        }
      }
    },
    "bridgePreviewParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "maxSize"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "maxSize": {
          "type": "integer",
          "minimum": 1
        },
        "draft": {
          "type": "boolean",
          "description": "Preview the agent's draft of the document instead."
        }
      }
    },
    "bridgePreviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "png"
      ],
      "properties": {
        "png": {
          "type": "string",
          "description": "The preview as base64 PNG."
        }
      }
    },
    "bridgeChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "by"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "by": {
          "enum": [
            "person",
            "agent"
          ]
        }
      },
      "description": "kit.changed: a live document changed."
    },
    "bridgeDocumentsOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workspacePath"
          }
        }
      },
      "description": "documents.open (renderer to runtime, notification): every Markdown document open in this window's document sessions, the whole list each time it changes and after bridge.ready."
    },
    "bridgeDocumentReadParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        }
      },
      "description": "document/read: the live text of an open document, unsaved edits included."
    },
    "bridgeDocumentReadResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open",
            "content"
          ],
          "properties": {
            "open": {
              "const": true
            },
            "content": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open"
          ],
          "properties": {
            "open": {
              "const": false
            }
          }
        }
      ]
    },
    "bridgeDocumentApplyParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "tool"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/workspacePath"
        },
        "content": {
          "type": "string",
          "description": "The document's whole new text; the session applies the difference as the agent's edit."
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "The agent tool that made the edit, such as document_write or apply_patch."
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "description": "The agent turn the edit belongs to, when known."
        }
      },
      "description": "document/apply: the agent's edit to an open document. The session applies and saves it, then answers; a window that does not answer in time (10 s) leaves the runtime to write the file."
    },
    "bridgeDocumentApplyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applied",
            "content"
          ],
          "properties": {
            "applied": {
              "const": true
            },
            "content": {
              "type": "string",
              "description": "The file content after the session saved."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applied",
            "reason"
          ],
          "properties": {
            "applied": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "Why the window did not apply it, such as not-open."
            }
          }
        }
      ]
    }
  }
}
