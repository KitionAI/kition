{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kition.ai/contracts/runtime/data-import.schema.json",
  "title": "Kition Data Import Contract",
  "description": "Public wire contract for previewing and importing CSV, TSV, and XLSX files into Kitable resources.",
  "$defs": {
    "format": {
      "type": "string",
      "enum": ["csv", "tsv", "xlsx"]
    },
    "field_type": {
      "type": "string",
      "enum": ["text", "long_text", "number", "date", "datetime", "single_select", "multi_select", "checkbox", "url"]
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "workspace_path"],
          "properties": {
            "kind": { "const": "workspace" },
            "workspace_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "upload_name"],
          "properties": {
            "kind": { "const": "upload" },
            "upload_name": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "title", "type", "nullable", "sample_values"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/field_type" },
        "nullable": { "type": "boolean" },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "sample_values": {
          "type": "array",
          "items": { "type": ["string", "number", "boolean", "null"] },
          "maxItems": 20
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "index", "hidden", "row_count", "field_count"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "hidden": { "type": "boolean" },
        "row_count": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 }
      }
    },
    "preview_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "sheet": { "type": "string" }
      }
    },
    "preview_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_token", "source", "format", "row_count", "field_count", "fields", "sample_rows", "warnings", "sheets"],
      "properties": {
        "import_token": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/source" },
        "filename": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "encoding": { "type": "string" },
        "delimiter": { "type": "string", "maxLength": 1 },
        "selected_sheet": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "sample_rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] }
          },
          "maxItems": 100
        },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "sheets": {
          "type": "array",
          "items": { "$ref": "#/$defs/sheet" }
        }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "table_title"],
          "properties": {
            "kind": { "const": "new_document" },
            "path": { "type": "string", "minLength": 1 },
            "table_title": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "document_id", "table_title"],
          "properties": {
            "kind": { "const": "new_table" },
            "document_id": { "type": "integer", "minimum": 1 },
            "table_title": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "document_id", "table_id"],
          "properties": {
            "kind": { "const": "existing_table" },
            "document_id": { "type": "integer", "minimum": 1 },
            "table_id": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "field_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "title", "type"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/field_type" },
        "options": { "type": "object", "additionalProperties": true }
      }
    },
    "execute_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_token", "target", "write_mode", "schema_mode"],
      "properties": {
        "import_token": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "write_mode": { "type": "string", "enum": ["replace", "append", "upsert"] },
        "schema_mode": { "type": "string", "enum": ["auto", "preserve", "replace"] },
        "unique_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "field_overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/field_override" }
        },
        "idempotency_key": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows_total", "rows_created", "rows_updated", "rows_skipped", "fields_created", "fields_updated", "warnings"],
      "properties": {
        "document_id": { "type": "integer", "minimum": 1 },
        "table_id": { "type": "integer", "minimum": 1 },
        "path": { "type": "string" },
        "rows_total": { "type": "integer", "minimum": 0 },
        "rows_created": { "type": "integer", "minimum": 0 },
        "rows_updated": { "type": "integer", "minimum": 0 },
        "rows_skipped": { "type": "integer", "minimum": 0 },
        "fields_created": { "type": "integer", "minimum": 0 },
        "fields_updated": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "stage", "processed_rows", "total_rows", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["queued", "running", "completed", "failed", "canceled"] },
        "stage": { "type": "string", "enum": ["queued", "parsing", "validating", "writing_schema", "writing_records", "finalizing", "completed", "failed", "canceled"] },
        "processed_rows": { "type": "integer", "minimum": 0 },
        "total_rows": { "type": "integer", "minimum": 0 },
        "result": { "$ref": "#/$defs/result" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/preview_request" },
    { "$ref": "#/$defs/preview_response" },
    { "$ref": "#/$defs/execute_request" },
    { "$ref": "#/$defs/job" }
  ]
}
