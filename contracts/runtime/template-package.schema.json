{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kition.ai/contracts/runtime/template-package.schema.json",
  "title": "Kition Template Package Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "snapshotVersion",
    "title",
    "description",
    "includeData",
    "defaultResourceId",
    "resources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "snapshotVersion": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "includeData": {
      "type": "boolean"
    },
    "defaultResourceId": {
      "type": "string",
      "minLength": 1
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "table",
            "view",
            "dashboard",
            "app",
            "automation",
            "attachment",
            "design"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "slots": {
          "description": "Editable slots a design resource exposes. Present only for the design kind.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/designSlot"
          }
        },
        "brandBindings": {
          "description": "Brand kit values a design resource binds when a brand is applied. Present only for the design kind.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/brandBinding"
          }
        }
      }
    },
    "designSlot": {
      "enum": [
        "headline",
        "body",
        "label",
        "image",
        "logo",
        "accent"
      ]
    },
    "brandBinding": {
      "enum": [
        "primary",
        "accent",
        "text",
        "surface",
        "font"
      ]
    }
  }
}
