{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kition.ai/contracts/kit/kit-index.schema.json",
  "title": "Kition Kit Index",
  "description": "Signed list of published kits. The host installs exact versions from this index and verifies every asset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "kits"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "kits": {
      "type": "array",
      "items": { "$ref": "#/$defs/kitEntry" }
    }
  },
  "$defs": {
    "kitEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^kit\\.[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "builtIn": {
          "type": "boolean",
          "description": "Shipped inside the Kition installer; never downloaded."
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/kitVersion" }
        }
      }
    },
    "kitVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "kitProtocol", "releaseTag", "assets"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "kitProtocol": { "type": "integer", "minimum": 1 },
        "minHostVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "releaseTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+" },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "description": "Keyed by target, for example darwin-arm64, darwin-x64, win32-x64, linux-x64, or web.",
          "propertyNames": { "pattern": "^(darwin|win32|linux)-(arm64|x64)$|^web$" },
          "additionalProperties": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
