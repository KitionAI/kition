{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KitionAI/kition-sdk/schemas/kit.schema.json",
  "title": "Kition kit manifest (kit.json): KHP 1.0's manifest plus the Kition kit platform's fields",
  "description": "KHP's fields (khp, id, name, version, formats, creates, exports, agent, level) follow KHP spec/manifest.md, rules K1, K2, K4, K5, K16, K17, K19; the other fields are the Kition kit platform's (docs/platform/kits/manifest.md, rules K3, K6 to K15, K18). tools/check-manifest.mjs checks both and names the rules as KHP or platform rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "khp",
    "id",
    "name",
    "version",
    "license",
    "engine",
    "formats"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "khp": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "The KHP version the kit conforms to, as major.minor (KHP K2): 1.0. It says nothing about the Kition platform fields (engine.contract, model, ui), which carry their own versions. The field was named standard before edition 2026.10; there is no alias."
    },
    "level": {
      "enum": [
        "basic",
        "agent-ready",
        "agent-ready-complete"
      ],
      "description": "The KHP tier the kit claims (KHP K19, spec/agent.md section 10); missing means basic."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "description": "Reverse-domain-style kit id (KHP K1)."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "distribution": {
      "enum": [
        "default",
        "plugin"
      ],
      "description": "default: ships with a host; plugin: installed on demand (platform K11)."
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "class",
        "contract"
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The engine module's name: the wasm-pack module (rust-wasm), or the ES module <module>.js of a TypeScript engine (ts-worker)."
        },
        "class": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "description": "The exported document class."
        },
        "runtime": {
          "enum": [
            "rust-wasm",
            "ts-worker"
          ],
          "description": "How the engine runs in the page: a Rust engine compiled to WebAssembly, or a TypeScript engine in a worker (platform K11)."
        },
        "contract": {
          "type": "integer",
          "minimum": 1,
          "description": "The engine contract (platform K3, docs/platform/kits/engine.md): 1 (KitDocument), or 2 (a KDM session; platform K10). contractVersion() answers it, or 1 for a contract 2 engine built before contract 2 hosts.",
          "maximum": 2
        },
        "crate": {
          "type": "string"
        }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "extensions",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "extensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/extension"
            }
          },
          "mime": {
            "type": "string"
          },
          "role": {
            "enum": [
              "edit",
              "view"
            ],
            "description": "edit: the kit opens these files and saves them in place (KHP K4); view: it opens them read-only."
          }
        }
      }
    },
    "creates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "extension",
          "baseName",
          "size"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "extension": {
            "$ref": "#/$defs/extension"
          },
          "baseName": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "$ref": "#/$defs/size"
          }
        }
      }
    },
    "exports": {
      "type": "array",
      "description": "Files the kit writes as new files only (KHP K5).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "extension",
          "command"
        ],
        "properties": {
          "extension": {
            "$ref": "#/$defs/extension"
          },
          "mime": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        }
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "extensions",
          "action"
        ],
        "properties": {
          "extensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/extension"
            }
          },
          "action": {
            "enum": [
              "project-from-clip",
              "open-as-document",
              "place"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "lent-files",
          "audio",
          "stepped-export",
          "selection-outline",
          "pages",
          "timeline",
          "engine-tools",
          "kdm",
          "files",
          "preview-files",
          "open-file",
          "open-url"
        ]
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "description": "The files beyond its document a kit may ask the host for (KitFiles 1.1; platform docs/platform/kits/manifest.md, K15). A kit with this field lists the files capability.",
      "properties": {
        "read": {
          "type": "array",
          "uniqueItems": true,
          "description": "Extensions, without the dot, of files the kit may read.",
          "items": {
            "$ref": "#/$defs/extension"
          }
        },
        "create": {
          "type": "array",
          "uniqueItems": true,
          "description": "Extensions, without the dot, of files the kit may create or replace; covers every extension in exports.",
          "items": {
            "$ref": "#/$defs/extension"
          }
        },
        "folders": {
          "type": "boolean",
          "description": "Folder grants are allowed (default false)."
        },
        "print": {
          "type": "boolean",
          "description": "files/print is allowed (default false)."
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schemaVersion"
      ],
      "description": "The kit's KDM schema (platform docs/platform/sets/model.md, K12).",
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*\\.json$",
          "description": "The schema file's path relative to kit.json (model/schema.json in a package)."
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Equal to the schema file's schemaVersion."
        }
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge"
      ],
      "description": "How the kit's documents merge (platform docs/platform/kits/manifest.md, K13).",
      "properties": {
        "merge": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "structured",
              "rich-text",
              "database",
              "grid",
              "timeline",
              "raster",
              "overlay",
              "binary"
            ]
          },
          "description": "The merge classes the kit's data maps to."
        },
        "leases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The scopes the kit leases before coordinated edits, as patterns such as layer:{objectId}, or * (platform M21)."
        },
        "serverValidation": {
          "type": "boolean",
          "description": "Whether a server should validate pushed changes with the kit's headless engine."
        },
        "comments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commands"
          ],
          "description": "How the kit's comment threads are written (a kit with a KDM schema, platform M23).",
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)+$"
              },
              "description": "The engine commands that write only CommentThread and Comment objects: what a commenter's read-only session runs (Kit UI protocol document.comments)."
            }
          }
        }
      }
    },
    "objectModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace"
      ],
      "description": "The kit's object model (KitObjectModel, platform K14).",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "description": "The namespace of the generated typings (@kition/sdk kits/<namespace>)."
        }
      }
    },
    "extras": {
      "type": "object",
      "description": "Methods beyond the contract, reachable through invoke (platform K6).",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "params",
          "returns"
        ],
        "properties": {
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "returns": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "menus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "enum": [
            "canvas",
            "timeline",
            "pages"
          ]
        },
        "mode": {
          "enum": [
            "embedded"
          ],
          "description": "The kit draws its editor (embedded, over the Kit UI protocol), platform K8. Host-drawn editors (\"host\") are retired."
        },
        "display": {
          "enum": ["menus", "line", "classic"],
          "description": "The editor's default display mode (platform U5c): menus, a single line of commands, or the classic ribbon. Focus is entered, never a default."
        },
        "entry": {
          "type": "string",
          "pattern": "^[^/][^:]*\\.html$",
          "description": "The embedded UI's HTML entry, relative to the package root."
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "description": "The kit's brand color per color scheme (platform U5b): the editor's primary color unless the host keeps its own.",
          "properties": {
            "light": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "dark": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "embedded"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "entry"
            ]
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix"
      ],
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$",
          "description": "Tool name prefix (KHP A2)."
        },
        "drafts": {
          "type": "boolean",
          "description": "The kit supports drafts and offers the draft tools (KHP A12, A35). Default false."
        },
        "objectModel": {
          "type": "boolean",
          "description": "The kit has an object model and offers <prefix>_query and <prefix>_batch (KHP A16, A35). Default false. On Kition's platform its headless executable serves model.describe and model.batch."
        },
        "layout": {
          "type": "boolean",
          "description": "A layout kit: its documents are laid out into pages, slides, or print areas (KHP A40). Default false."
        },
        "tools": {
          "enum": [
            "document",
            "commands"
          ],
          "description": "Kition platform: document, only the document tools; commands, also one tool per agent-facing command."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "headless": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "protocol"
      ],
      "properties": {
        "executable": {
          "type": "string"
        },
        "protocol": {
          "const": "kition-kit/1"
        },
        "features": {
          "type": "array",
          "description": "Optional Kit Host Protocol features the executable serves, as kit.initialize lists them in capabilities.features (for example model.describe and model.batch, the object model).",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9_]*(\\.[a-z][A-Za-z0-9_]*)+$"
          }
        }
      }
    }
  },
  "$defs": {
    "extension": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,12}$"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
