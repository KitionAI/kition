{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kition.ai/contracts/kit/kit-protocol.schema.json",
  "title": "Kition Kit Protocol v1",
  "description": "Parameter and result shapes for Kit Protocol methods. Messages are JSON-RPC 2.0; see docs/kit-protocol.md.",
  "$defs": {
    "uri": {
      "type": "string",
      "pattern": "^file://"
    },
    "documentId": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mimeType", "width", "height", "data"],
      "properties": {
        "mimeType": { "const": "image/png" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "data": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "shortcut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "code", "modifiers"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "modifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["alt", "ctrl", "meta", "shift"] }
        }
      }
    },
    "bounds": {
      "description": "Logical pixels. Relative to the host content area for child-window and shared-texture; screen coordinates for overlay-window and top-level.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "emptyResult": {
      "type": "object",
      "additionalProperties": false
    },

    "initializeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "token", "role", "client"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": { "enum": ["host", "agent"] },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "locale": { "type": "string", "minLength": 2 },
        "appearance": { "enum": ["light", "dark"] },
        "reservedShortcuts": {
          "type": "array",
          "items": { "$ref": "#/$defs/shortcut" }
        },
        "workspaceRoots": {
          "type": "array",
          "items": { "$ref": "#/$defs/uri" }
        }
      }
    },
    "initializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "kit", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "kit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaces", "formats"],
      "properties": {
        "surfaces": {
          "type": "array",
          "items": { "enum": ["embedded", "window", "web", "headless"] }
        },
        "embeddingMechanisms": {
          "type": "array",
          "items": { "enum": ["child-window", "overlay-window", "shared-texture", "top-level"] }
        },
        "formats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["open", "save", "export"],
          "properties": {
            "open": { "type": "array", "items": { "type": "string" } },
            "save": { "type": "array", "items": { "type": "string" } },
            "export": { "type": "array", "items": { "type": "string" } }
          }
        },
        "features": {
          "type": "array",
          "description": "Optional protocol features, for example view.describe or commands.didChangeEnabled.",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_.]*$" }
        }
      }
    },
    "setPreferencesParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 2 },
        "appearance": { "enum": ["light", "dark"] }
      }
    },
    "cancelRequestParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": ["integer", "string"] }
      }
    },

    "documentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "uri", "title", "format", "readOnly", "dirty", "canUndo", "canRedo"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "uri": { "anyOf": [{ "$ref": "#/$defs/uri" }, { "type": "null" }] },
        "title": { "type": "string" },
        "format": { "type": "string", "minLength": 1 },
        "readOnly": { "type": "boolean" },
        "dirty": { "type": "boolean" },
        "canUndo": { "type": "boolean" },
        "canRedo": { "type": "boolean" }
      }
    },
    "documentOpenParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "$ref": "#/$defs/uri" },
        "readOnly": { "type": "boolean" },
        "create": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format"],
          "properties": {
            "format": { "type": "string", "minLength": 1 },
            "options": { "type": "object" }
          }
        }
      }
    },
    "documentListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents"],
      "properties": {
        "documents": { "type": "array", "items": { "$ref": "#/$defs/documentState" } }
      }
    },
    "documentRefParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" }
      }
    },
    "documentSaveAsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "uri"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "uri": { "$ref": "#/$defs/uri" },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "documentExportParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "uri", "format"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "uri": { "$ref": "#/$defs/uri" },
        "format": { "type": "string", "minLength": 1 },
        "options": { "type": "object" }
      }
    },
    "documentUriResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "$ref": "#/$defs/uri" }
      }
    },
    "documentCloseParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "discardChanges": { "type": "boolean" }
      }
    },
    "documentDidSaveParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "uri"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "uri": { "$ref": "#/$defs/uri" }
      }
    },

    "commandInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "group", "params", "mutates", "enabled"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "group": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "description": "JSON Schema (draft 2020-12) for commands.execute params."
        },
        "mutates": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "menu": {
          "type": "array",
          "description": "Where the command sits in the kit's menus, for example [\"Layer\", \"New\"]. A host that draws the kit's chrome builds its menus from it.",
          "items": { "type": "string", "minLength": 1 }
        },
        "shortcut": {
          "type": "string",
          "description": "The default shortcut, for example Cmd+Shift+N."
        }
      }
    },
    "commandsListParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "groups": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commandsListResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": { "type": "array", "items": { "$ref": "#/$defs/commandInfo" } }
      }
    },
    "commandsExecuteParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "command", "params", "origin"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "command": { "type": "string", "minLength": 1 },
        "params": { "type": "object" },
        "origin": { "enum": ["user", "agent"] }
      }
    },
    "commandsExecuteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed"],
      "properties": {
        "changed": { "type": "boolean" },
        "result": {}
      }
    },
    "commandsDidChangeEnabledParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "enabled", "disabled"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "enabled": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "array", "items": { "type": "string" } }
      }
    },

    "viewScreenshotParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "scope"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "scope": { "enum": ["canvas", "surface"] },
        "maxSize": { "type": "integer", "minimum": 16 }
      }
    },
    "viewDescribeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "state"],
      "properties": {
        "summary": { "type": "string" },
        "state": { "type": "object" }
      }
    },

    "surfaceAttachParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "bounds", "scaleFactor", "visible"],
      "properties": {
        "mechanism": { "enum": ["child-window", "overlay-window", "shared-texture", "top-level"] },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "handle"],
          "properties": {
            "platform": { "enum": ["macos", "windows", "x11"] },
            "handle": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        "bounds": { "$ref": "#/$defs/bounds" },
        "scaleFactor": { "type": "number", "exclusiveMinimum": 0 },
        "visible": { "type": "boolean" }
      },
      "if": { "properties": { "mechanism": { "enum": ["child-window", "overlay-window"] } } },
      "then": { "required": ["parent"] }
    },
    "surfaceSetBoundsParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds", "scaleFactor"],
      "properties": {
        "bounds": { "$ref": "#/$defs/bounds" },
        "scaleFactor": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "surfaceSetVisibleParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible"],
      "properties": {
        "visible": { "type": "boolean" }
      }
    },
    "surfaceFocusExitParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction"],
      "properties": {
        "direction": { "enum": ["next", "previous"] }
      }
    },

    "progressParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "title", "done"],
      "properties": {
        "token": { "type": ["integer", "string"] },
        "title": { "type": "string" },
        "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "done": { "type": "boolean" }
      }
    },
    "logParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "message"],
      "properties": {
        "level": { "enum": ["debug", "info", "warn", "error"] },
        "message": { "type": "string" }
      }
    },
    "errorData": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {
          "enum": [
            "unauthorized",
            "not_initialized",
            "role_forbidden",
            "unsupported_protocol",
            "document_not_found",
            "document_dirty",
            "unsupported_format",
            "io_error",
            "uri_not_granted",
            "command_not_found",
            "command_disabled",
            "invalid_params",
            "surface_mechanism_unsupported",
            "surface_not_attached",
            "request_cancelled"
          ]
        },
        "detail": { "type": "string" },
        "errors": { "type": "array" }
      }
    }
  }
}
