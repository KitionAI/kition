{
  "name": "kition",
  "version": "0.1.49",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Kition — documents, structured tables, AI agents, and visual workflows",
  "homepage": "https://kition.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition.git"
  },
  "author": {
    "name": "Heartie Technology Limited",
    "email": "support@kition.ai"
  },
  "bugs": {
    "url": "https://github.com/KitionAI/kition/issues",
    "email": "support@kition.ai"
  },
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": ">=10.16.0 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "keywords": [
    "kition",
    "ai-workspace",
    "automation",
    "tauri",
    "documents",
    "tables",
    "agents"
  ],
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --config tooling/vite.config.ts --mode web-preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "check:branding": "python3 scripts/check-branding.py",
    "check:product-language": "python3 scripts/check-product-language.py",
    "check:i18n": "python3 scripts/check-i18n.py",
    "check:blank-comments": "python3 scripts/check-blank-comment-blocks.py",
    "check:knip": "node scripts/check-knip-baseline.mjs",
    "check:knip:update": "node scripts/check-knip-baseline.mjs --update",
    "check:deps": "depcruise --config tooling/dependency-cruiser.cjs --ignore-known tooling/dependency-cruiser.known.json --output-type err src",
    "check:deps:update": "depcruise --config tooling/dependency-cruiser.cjs --baseline tooling/dependency-cruiser.known.json --baseline-mode shrink-only src",
    "check:e2e-coverage": "node scripts/check-e2e-coverage.mjs",
    "contracts:generate": "node scripts/generate-contract-types.mjs",
    "check:contracts": "node scripts/generate-contract-types.mjs --check",
    "check": "pnpm run check:branding && pnpm run check:product-language && pnpm run check:i18n && pnpm run check:blank-comments && pnpm run check:knip && pnpm run check:deps && pnpm run check:e2e-coverage && pnpm run check:contracts && pnpm run lint && pnpm run check:security && pnpm run build:check && pnpm test",
    "build": "vite build --config tooling/vite.config.ts",
    "build:check": "pnpm run check:desktop-assets && pnpm run check:notices && pnpm run typecheck && pnpm run build",
    "check:desktop-assets": "node src-tauri/scripts/validate-desktop-assets.mjs",
    "check:notices": "node scripts/generate-third-party-notices.mjs --check",
    "check:security": "python3 scripts/check-secrets.py && pnpm audit --audit-level high --ignore-registry-errors",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "build:perf": "pnpm run build && pnpm perf:budget",
    "build:desktop": "node src-tauri/scripts/build.mjs",
    "dist:desktop": "node src-tauri/scripts/build.mjs",
    "check:desktop": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "release:github": "node scripts/release-github.mjs",
    "test:agent:unit": "vitest run --config tooling/vitest.config.ts src/features/agent/hooks/useTableAgentSession.spec.ts src/features/agent/lib/tableAgentShared.spec.ts src/features/workspace/lib/workspacePersistence.spec.ts",
    "test:agent:e2e": "playwright test --config tooling/playwright.config.ts e2e/table-agent-document-flow.spec.ts e2e/markdown-image-insertion.spec.ts --workers=1",
    "test:agent:stable": "pnpm run test:agent:unit && pnpm run test:agent:e2e",
    "test:desktop:unit": "vitest run --config tooling/vitest.config.ts src/services/desktop.spec.ts src/services/desktopBootstrap.spec.ts src/services/portalAccount.spec.ts src/services/desktopClient/tauriBridge.spec.ts src-tauri/scripts",
    "test:desktop:e2e": "playwright test --config tooling/playwright.config.ts e2e/desktop-bundled-assets.spec.ts e2e/desktop-design-studio.spec.ts e2e/desktop-design.spec.ts e2e/desktop-image-copy.spec.ts e2e/desktop-image-import.spec.ts e2e/desktop-image-paste.spec.ts e2e/desktop-selection-translation.spec.ts e2e/desktop-shortcuts.spec.ts e2e/desktop-template-creation.spec.ts e2e/settings-desktop.spec.ts e2e/settings-desktop-network.spec.ts",
    "lint": "eslint . --config tooling/eslint.cjs --no-eslintrc --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --quiet --ignore-path .gitignore",
    "lint:fix": "eslint . --config tooling/eslint.cjs --no-eslintrc --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "test:unit": "vitest run --config tooling/vitest.config.ts",
    "test:coverage": "vitest run --config tooling/vitest.config.ts --coverage",
    "test:unit:watch": "vitest --config tooling/vitest.config.ts",
    "test:e2e": "playwright test --config tooling/playwright.config.ts e2e/app-shell.spec.ts e2e/table-widget.spec.ts --workers=1",
    "test:e2e:ci": "KITION_E2E_SCOPE=ci playwright test --config tooling/playwright.config.ts --workers=2 && playwright test --config tooling/playwright.config.ts e2e/design-performance.spec.ts --workers=1",
    "test:e2e:headed": "playwright test --config tooling/playwright.config.ts --headed",
    "test:design:unit": "vitest run --config tooling/vitest.config.ts src/features/design src/features/workspace/lib/workspaceDesign.spec.ts",
    "test:design:e2e": "playwright test --config tooling/playwright.config.ts e2e/design-editor.spec.ts e2e/desktop-design.spec.ts e2e/design-performance.spec.ts --workers=1",
    "test:whiteboard:e2e": "playwright test --config tooling/playwright.config.ts e2e/whiteboard-editing.spec.ts e2e/whiteboard-agent.spec.ts e2e/whiteboard-image-studio.spec.ts --workers=1",
    "test:whiteboard:e2e:headed": "pnpm run test:whiteboard:e2e --headed",
    "capture:readme:assets": "KITION_CAPTURE_README_ASSETS=1 playwright test --config tooling/playwright.config.ts e2e/readme-assets.spec.ts --workers=1 && magick docs/readme/documents.png -quality 88 -define webp:method=6 docs/readme/documents.webp && magick docs/readme/agent.png -quality 88 -define webp:method=6 docs/readme/agent.webp && magick docs/readme/whiteboards.png -quality 88 -define webp:method=6 docs/readme/whiteboards.webp && magick docs/readme/kition-overview.png -quality 88 -define webp:method=6 docs/readme/kition-overview.webp && magick docs/readme/design-studio.png -quality 88 -define webp:method=6 docs/readme/design-studio.webp && rm docs/readme/documents.png docs/readme/agent.png docs/readme/whiteboards.png docs/readme/design-studio.png",
    "test:table:e2e": "bash scripts/inspect-table-widget.sh",
    "test:kitable:e2e": "bash scripts/inspect-kitable.sh",
    "test:scenario:e2e": "bash scripts/inspect-scenario.sh",
    "test:workflow:e2e": "bash scripts/inspect-workflow.sh",
    "test:workflow:ai-build:e2e": "playwright test --config tooling/playwright.config.ts e2e/workflow-real-ai-build.spec.ts --workers=1",
    "test:workflow:onboarding:e2e": "bash scripts/inspect-workflow-onboarding.sh"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@orama/orama": "^3.1.18",
    "@playwright/test": "^1.54.2",
    "@tanstack/react-query": "^5.104.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/scroller": "^0.1.5",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@uiw/react-codemirror": "^4.25.10",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "codemirror": "^6.0.2",
    "dependency-cruiser": "^18.4.0",
    "dompurify": "3.4.13",
    "eslint": "^8.56.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-sonarjs": "^1.0.4",
    "fake-indexeddb": "^6.2.5",
    "i18next": "^26.3.1",
    "idb": "^8.0.3",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "knip": "^6.38.0",
    "lodash-es": "^4.17.21",
    "lru-cache": "10.2.0",
    "lucide-react": "^1.14.0",
    "marked": "^12.0.0",
    "mermaid": "^11.16.1",
    "postcss": "^8.5.26",
    "radix-ui": "1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-grid-layout": "^2.2.3",
    "react-hammerjs": "1.0.1",
    "react-hotkeys-hook": "^5.3.2",
    "react-i18next": "^17.0.8",
    "react-resizable": "^3.2.0",
    "react-textarea-autosize": "8.5.3",
    "recharts": "^3.10.1",
    "scroller": "0.0.3",
    "sonner": "2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "ts-key-enum": "2.0.12",
    "ts-keycode-enum": "1.0.6",
    "turndown": "^7.2.4",
    "typescript": "6.0.3",
    "vaul": "1.1.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "4.1.13"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "dompurify": "3.4.13",
      "fast-uri": "3.1.7",
      "form-data": "4.0.6",
      "immutable": "5.1.8",
      "js-yaml": "4.3.2",
      "tar@>=7.0.0 <7.5.21": "7.5.21",
      "tmp": "0.2.7",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "browserslist": "4.28.7",
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "postcss-selector-parser@>=6.0.0 <6.1.4": "6.1.4"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch",
      "@codemirror/view@6.43.0": "patches/@codemirror__view@6.43.0.patch"
    }
  }
}
