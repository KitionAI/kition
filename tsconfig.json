{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kition/app-ui": ["packages/app-ui/src/index.tsx"],
      "@kition/app-ui/*": ["packages/app-ui/src/*"],
      "@kition/board-editor": ["packages/board-editor/src/index.ts"],
      "@kition/board-editor/*": ["packages/board-editor/src/*"],
      "@kition/document-editor": ["packages/document-editor/src/index.ts"],
      "@kition/document-editor/*": ["packages/document-editor/src/*"],
      "@kition/kdm": ["src/lib/kdm/index.ts"],
      "@kition/kit-engine": ["src/lib/kit-engine/index.ts"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/api/**/*.ts",
    "src/api/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/services/**/*.ts",
    "src/services/**/*.tsx",
    "src/types/**/*.ts",
    "src/types/**/*.tsx",
    "src/i18n/**/*.ts",
    "src/i18n/**/*.tsx",
    "src/i18n/**/*.json",
    "src/utils/**/*.ts",
    "src/utils/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/src/**/*.json"
  ],
  "references": [{ "path": "./tooling/tsconfig.node.json" }]
}
