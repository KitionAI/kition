{
  "khp": "1.0",
  "level": "basic",
  "id": "kit.html",
  "name": "HTML",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "distribution": "plugin",
  "capabilities": [
    "kdm"
  ],
  "engine": {
    "runtime": "rust-wasm",
    "module": "kition_html_kit",
    "class": "HtmlDocument",
    "contract": 2,
    "crate": "kition-html-kit",
    "editorState": ["width", "height"]
  },
  "model": {
    "schema": "crates/kition-html-kit/model/schema.json",
    "schemaVersion": 1
  },
  "collaboration": {
    "merge": [
      "rich-text"
    ],
    "leases": [],
    "serverValidation": false
  },
  "objectModel": {
    "namespace": "Html"
  },
  "formats": [
    {
      "id": "html",
      "extensions": [
        "html",
        "htm"
      ],
      "mime": "text/html",
      "role": "edit"
    }
  ],
  "creates": [
    {
      "id": "html",
      "extension": "html",
      "baseName": "Untitled HTML",
      "size": {
        "width": 640,
        "height": 480
      }
    }
  ],
  "extras": {
    "setResource": {
      "params": [
        "path: string",
        "bytes: Uint8Array"
      ],
      "returns": "void",
      "description": "Supply host-read bytes under /assets/."
    },
    "setViewport": {
      "params": [
        "width: u32",
        "height: u32",
        "dark: boolean"
      ],
      "returns": "void",
      "description": "Set the transient CSS viewport and color scheme."
    },
    "renderPng": {
      "params": [],
      "returns": "Uint8Array",
      "description": "Return a PNG snapshot without writing a file."
    }
  },
  "ui": {
    "menus": [
      "Edit"
    ],
    "layout": "canvas",
    "brand": {
      "light": "#b64b22",
      "dark": "#ff986b"
    },
    "display": "menus"
  },
  "agent": {
    "prefix": "html",
    "tools": "document",
    "drafts": false,
    "objectModel": false,
    "layout": false,
    "describe": {
      "noun": "HTML document",
      "fileTypes": "HTML (.html or .htm)",
      "reports": "its HTML source, viewport, and undo state",
      "covers": "HTML source replacement and undo/redo; HTML/CSS rendering and bounded JavaScript with supplied resources",
      "queries": "`Replace HTML` or `Undo`",
      "example": "html.setSource"
    }
  },
  "headless": {
    "executable": "kition-html",
    "protocol": "kition-kit/1",
    "features": [
      "view.describe",
      "document.check",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch",
      "document.identity"
    ]
  }
}
