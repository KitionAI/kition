{
  "$schema": "https://github.com/KitionAI/kition-sdk/schemas/kit.schema.json",
  "khp": "1.0",
  "level": "basic",
  "id": "kit.note",
  "name": "Note",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "distribution": "plugin",
  "engine": {
    "runtime": "rust-wasm",
    "module": "kition_note_kit",
    "class": "NoteDocument",
    "contract": 2,
    "crate": "kition-note-kit",
    "editorState": ["view"]
  },
  "formats": [
    {
      "id": "markdown",
      "extensions": ["md", "markdown"],
      "mime": "text/markdown",
      "role": "edit"
    }
  ],
  "creates": [
    {
      "id": "note",
      "extension": "md",
      "baseName": "Untitled note",
      "size": { "width": 612, "height": 792 }
    }
  ],
  "capabilities": ["kdm", "pages", "files", "open-file", "open-url"],
  "files": { "create": ["html", "pdf", "png", "jpg", "gif", "webp", "svg", "avif"], "print": true },
  "ui": {
    "mode": "embedded",
    "entry": "ui/index.html",
    "menus": ["File", "Edit", "Format", "Insert", "View"],
    "layout": "pages",
    "display": "line",
    "brand": { "light": "#5645d4", "dark": "#8b7cf0" }
  },
  "agent": {
    "prefix": "note",
    "tools": "document",
    "drafts": true,
    "objectModel": true,
    "layout": true,
    "export": { "command": "file.export", "data": "data" },
    "exclude": ["link.retarget", "comment.move", "comment.delete", "select.get", "select.set", "edit.selectAll", "edit.cut", "table.geometry", "code.blocks", "diagram.view", "diagram.set", "property.view", "image.wanted", "image.set", "select.replace", "view.width", "view.scheme", "view.hoverOut", "select.where", "view.blockAt", "view.foldProperties", "format.math", "format.highlightColor", "format.clear", "select.controlKey", "format.bold", "format.italic", "format.strike", "format.code", "format.highlight", "format.link", "format.paragraph", "format.heading1", "format.heading2", "format.heading3", "format.heading4", "format.heading5", "format.heading6", "list.bullet", "list.numbered", "list.task", "list.toggleCheckbox", "edit.indent", "edit.outdent", "edit.moveLineUp", "edit.moveLineDown", "edit.deleteParagraph", "format.comment", "format.quote", "format.headingUp", "format.headingDown", "view.fold", "view.foldAll", "view.unfoldAll", "view.foldMore", "view.foldLess", "edit.selectSection", "edit.sortLines", "edit.trimWhitespace", "wikilink.insert", "embed.insert", "image.insert", "tag.insert", "table.insert", "mathBlock.insert", "callout.insert", "footnote.insert", "date.insert", "timestamp.insert", "codeBlock.insert", "rule.insert"],
    "describe": {
      "noun": "note",
      "fileTypes": "Markdown (.md)",
      "reports": "its outline, properties, links, tables, tasks, and comment threads",
      "covers": "text, headings, lists, tasks, tables, properties, links, comments, templates, and more; `text.insert` adds text",
      "queries": "`table`, `property`, or `comment`",
      "example": "text.insert"
    }
  },
  "headless": {
    "executable": "kition-note",
    "protocol": "kition-kit/1",
    "features": [
      "view.describe",
      "document.check",
      "document.identity",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch"
    ]
  },
  "exports": [
    { "extension": "html", "mime": "text/html", "command": "file.export" },
    { "extension": "pdf", "mime": "application/pdf", "command": "file.export" }
  ],
  "extras": {
    "mergeFile": {
      "params": ["bytes: Uint8Array"],
      "returns": "string"
    },
    "exportHtml": {
      "params": ["standalone: boolean"],
      "returns": "string",
      "description": "The note as HTML (what file.export writes for html), without base64."
    },
    "exportPdf": {
      "params": ["pageSize: string"],
      "returns": "Uint8Array",
      "description": "The note as PDF bytes on letter or a4 pages (what file.export writes for pdf), without base64."
    }
  },
  "model": {
    "schema": "crates/kdm/kdm-model/model/schema.json",
    "schemaVersion": 1
  },
  "collaboration": {
    "merge": ["rich-text"],
    "leases": [],
    "serverValidation": false,
    "comments": {
      "commands": ["comment.add", "comment.reply", "comment.resolve", "comment.move", "comment.delete"]
    }
  },
  "objectModel": {
    "namespace": "Note"
  }
}
