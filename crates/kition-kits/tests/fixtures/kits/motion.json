{
  "$schema": "https://github.com/KitionAI/kition-sdk/schemas/kit.schema.json",
  "khp": "1.0",
  "level": "basic",
  "id": "kit.motion",
  "name": "Motion",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "distribution": "plugin",
  "engine": {
    "runtime": "rust-wasm",
    "module": "kition_motion_kit",
    "class": "MotionDocument",
    "contract": 2,
    "crate": "kition-motion-kit",
    "editorState": ["/time", "/info/transform", "selected"]
  },
  "formats": [
    {
      "id": "motion",
      "extensions": [
        "kmotion"
      ],
      "mime": "application/vnd.kition.motion+json",
      "role": "edit"
    }
  ],
  "creates": [
    {
      "id": "motion",
      "extension": "kmotion",
      "baseName": "Untitled motion",
      "size": {
        "width": 1920,
        "height": 1080
      }
    }
  ],
  "exports": [
    {
      "extension": "mp4",
      "mime": "video/mp4",
      "command": "file.exportMovie"
    }
  ],
  "capabilities": [
    "lent-files",
    "timeline",
    "kdm"
  ],
  "extras": {
    "takeFile": {
      "params": [
        "path: string"
      ],
      "returns": "Uint8Array | undefined",
      "description": "A file the engine wrote (a render), taken out of memory."
    },
    "renderMovie": {
      "params": [
        "path: string",
        "format: string"
      ],
      "returns": "Uint8Array",
      "description": "The active composition rendered as a movie from a copy of the project; the document is left unchanged."
    }
  },
  "ui": {
    "mode": "embedded",
    "display": "menus",
    "entry": "ui/index.html",
    "menus": [
      "File",
      "Edit",
      "Composition",
      "Layer",
      "Effect",
      "Animation",
      "View",
      "Window",
      "Help"
    ],
    "layout": "timeline",
    "brand": {
      "light": "#b03fd6",
      "dark": "#d27cf0"
    }
  },
  "agent": {
    "prefix": "motion",
    "tools": "document",
    "drafts": true,
    "objectModel": true,
    "layout": false,
    "render": "file.render",
    "parts": [
      "comp"
    ],
    "describe": {
      "noun": "motion graphics project",
      "fileTypes": ".kmotion",
      "reports": "its active composition, layers, and their keyframe times",
      "covers": "compositions, layers, keyframes, effects, masks, text, and more",
      "queries": "`outer glow`, `gradient ramp`, or `text preset`",
      "example": "layer.newSolid"
    },
    "export": {
      "command": "file.exportMovie",
      "data": "data"
    }
  },
  "headless": {
    "executable": "kition-motion",
    "protocol": "kition-kit/1",
    "capabilities": [
      "document-text"
    ],
    "features": [
      "view.describe",
      "document.check",
      "document.identity",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch"
    ]
  },
  "model": {
    "schema": "crates/kdm/kdm-model/model/schema.json",
    "schemaVersion": 3
  },
  "collaboration": {
    "merge": [
      "timeline",
      "binary"
    ],
    "leases": [],
    "serverValidation": false
  },
  "objectModel": {
    "namespace": "Motion"
  }
}
