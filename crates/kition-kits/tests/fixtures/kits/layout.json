{
  "$schema": "https://github.com/KitionAI/kition-sdk/schemas/kit.schema.json",
  "khp": "1.0",
  "level": "basic",
  "id": "kit.layout",
  "name": "Layout",
  "version": "0.1.4",
  "license": "Apache-2.0",
  "distribution": "plugin",
  "engine": {
    "runtime": "rust-wasm",
    "module": "kition_layout_kit",
    "class": "LayoutDocument",
    "contract": 2,
    "crate": "kition-layout-kit",
    "editorState": ["/selection", "/activeLayer", "/tool"]
  },
  "formats": [
    {
      "id": "layout",
      "extensions": [
        "klayout"
      ],
      "mime": "application/vnd.kition.layout+zip",
      "role": "edit"
    },
    {
      "id": "layout-import",
      "extensions": [
        "idml"
      ],
      "mime": "application/vnd.adobe.indesign-idml-package",
      "role": "view"
    }
  ],
  "creates": [
    {
      "id": "layout",
      "extension": "klayout",
      "baseName": "Untitled layout",
      "size": {
        "width": 612,
        "height": 792
      }
    }
  ],
  "exports": [
    {
      "extension": "pdf",
      "mime": "application/pdf",
      "command": "file.exportBytes"
    },
    {
      "extension": "png",
      "mime": "image/png",
      "command": "file.exportBytes"
    },
    {
      "extension": "jpg",
      "mime": "image/jpeg",
      "command": "file.exportBytes"
    },
    {
      "extension": "html",
      "mime": "text/html",
      "command": "file.exportBytes"
    },
    {
      "extension": "idml",
      "mime": "application/vnd.adobe.indesign-idml-package",
      "command": "file.exportBytes"
    },
    {
      "extension": "epub",
      "mime": "application/epub+zip",
      "command": "file.exportBytes"
    }
  ],
  "capabilities": [
    "kdm",
    "engine-tools",
    "pages"
  ],
  "ui": {
    "mode": "embedded",
    "display": "line",
    "entry": "ui/index.html",
    "menus": [
      "File",
      "Edit",
      "Layout",
      "Type",
      "Object",
      "Table",
      "View",
      "Window",
      "Help"
    ],
    "layout": "canvas",
    "brand": {
      "light": "#d32f8d",
      "dark": "#f57bbd"
    }
  },
  "agent": {
    "prefix": "layout",
    "tools": "document",
    "drafts": true,
    "objectModel": true,
    "layout": true,
    "render": "file.render",
    "exclude": [
      "file.print",
      "file.printers"
    ],
    "export": {
      "command": "file.exportBytes",
      "data": "data",
      "params": {}
    },
    "describe": {
      "noun": "page layout",
      "fileTypes": ".klayout",
      "reports": "its pages, spreads, frames, stories, styles, and swatches",
      "covers": "pages, frames, text, styles, swatches, tables, and more",
      "queries": "`text frame`, `paragraph style`, or `insert page`",
      "example": "frame.add"
    }
  },
  "headless": {
    "executable": "kition-layout",
    "protocol": "kition-kit/1",
    "features": [
      "view.describe",
      "document.check",
      "document.identity",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch"
    ]
  },
  "extras": {
    "setBackdrop": {
      "params": [
        "color: string"
      ],
      "returns": "void"
    }
  },
  "model": {
    "schema": "crates/kdm/kdm-model/model/schema.json",
    "schemaVersion": 2
  },
  "collaboration": {
    "merge": [
      "structured",
      "rich-text",
      "binary"
    ],
    "leases": [],
    "serverValidation": false
  },
  "objectModel": {
    "namespace": "Layout"
  }
}
