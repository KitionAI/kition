{
  "$schema": "https://github.com/KitionAI/kition-sdk/schemas/kit.schema.json",
  "khp": "1.0",
  "level": "basic",
  "id": "kit.table",
  "name": "Table",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "distribution": "default",
  "capabilities": [
    "kdm"
  ],
  "engine": {
    "runtime": "rust-wasm",
    "module": "kition_table_kit",
    "class": "TableDocument",
    "contract": 2,
    "crate": "kition-table-kit"
  },
  "formats": [
    {
      "id": "ktable",
      "extensions": [
        "ktable"
      ],
      "mime": "application/vnd.kition.table+sqlite3",
      "role": "edit"
    }
  ],
  "creates": [
    {
      "id": "table",
      "extension": "ktable",
      "baseName": "Untitled table",
      "size": {
        "width": 640,
        "height": 420
      }
    }
  ],
  "exports": [
    {
      "extension": "csv",
      "mime": "text/csv",
      "command": "table.file.export"
    },
    {
      "extension": "md",
      "mime": "text/markdown",
      "command": "table.file.export"
    }
  ],
  "extras": {
    "call": {
      "params": [
        "method",
        "paramsJson"
      ],
      "returns": "string",
      "description": "One data-document request (kition-table-api): answers { result, change } as JSON."
    },
    "takeImported": {
      "params": [],
      "returns": "string",
      "description": "The TableChanges of replica changes imported since the last call, as a JSON array of table/changed params."
    }
  },
  "ui": {
    "mode": "embedded",
    "entry": "ui/index.html",
    "menus": [
      "Edit"
    ],
    "layout": "canvas",
    "brand": {
      "light": "#0c8375",
      "dark": "#3fd1bf"
    }
  },
  "agent": {
    "prefix": "table",
    "tools": "document",
    "drafts": true,
    "objectModel": true,
    "layout": false,
    "parts": [
      "table",
      "view"
    ],
    "render": "table.file.render",
    "export": {
      "command": "table.file.export",
      "data": "data"
    },
    "describe": {
      "noun": "table file",
      "fileTypes": ".ktable",
      "reports": "its tables with their fields (names, types, choices, link targets), views (filters, sorts, groups), record counts and first records (ids and values, by the ids the commands take; the rest a page at a time with `table.read`), and its dashboards",
      "covers": "tables, fields, records, views, filters, sorting, grouping, links, dashboards, and more; `table.records.create` adds a record; a new file holds one starter table (table 1, `Table`: title, status, notes) that `table.tables.delete` removes",
      "queries": "`records`, `fields`, or `views`",
      "example": "table.records.create"
    }
  },
  "headless": {
    "executable": "kition-table",
    "protocol": "kition-kit/2",
    "features": [
      "view.describe",
      "document.check",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch"
    ]
  },
  "model": {
    "schema": "model/schema.json",
    "schemaVersion": 1
  },
  "collaboration": {
    "merge": [
      "database",
      "binary"
    ],
    "leases": [],
    "serverValidation": false
  },
  "objectModel": {
    "namespace": "Table"
  }
}
