{
  "khp": "1.0",
  "id": "kit.design",
  "name": "Design",
  "version": "0.1.0",
  "formats": [
    {
      "id": "design",
      "extensions": [
        "kdesign"
      ],
      "mime": "application/vnd.kition.design+zip",
      "role": "edit"
    },
    {
      "id": "design-import",
      "extensions": [
        "fig",
        "sketch"
      ],
      "mime": "application/octet-stream",
      "role": "view"
    }
  ],
  "creates": [
    {
      "id": "design",
      "extension": "kdesign",
      "baseName": "Untitled design"
    }
  ],
  "exports": [
    {
      "extension": "png",
      "mime": "image/png",
      "command": "file.export"
    },
    {
      "extension": "jpg",
      "mime": "image/jpeg",
      "command": "file.export"
    },
    {
      "extension": "svg",
      "mime": "image/svg+xml",
      "command": "file.export"
    },
    {
      "extension": "pdf",
      "mime": "application/pdf",
      "command": "file.export"
    }
  ],
  "capabilities": [
    "engine-tools",
    "kdm",
    "lent-files"
  ],
  "agent": {
    "prefix": "design",
    "tools": "document",
    "drafts": false,
    "objectModel": true,
    "layout": false,
    "render": "file.render",
    "export": {
      "command": "file.export",
      "data": "data",
      "params": {
        "ids": []
      }
    },
    "describe": {
      "noun": "interface design"
    }
  },
  "headless": {
    "executable": "kition-design",
    "protocol": "kition-kit/2",
    "features": [
      "view.describe",
      "document.check",
      "model.open",
      "model.import",
      "model.export",
      "model.save",
      "model.describe",
      "model.batch"
    ]
  }
}
