      "value": 1
     }
    ]
   },
   "error": {
    "code": "invalid-op",
    "message": "`field` `props.children.7.value`: `children` has 2 items, not 8"
   }
  },
  {
   "name": "no-such-words",
   "edit": {
    "ops": [
     {
      "op": "set",
      "target": "1",
      "field": "nowhere/x.value",
      "value": 1
     }
    ]
