  {
   "name": "text-set-inside-a-value",
   "edit": {
    "ops": [
     {
      "op": "text.set",
      "target": "1",
      "field": "transform/opacity.value.v",
      "text": "a"
     }
    ]
   },
   "error": {
    "code": "invalid-op",
    "message": "`field` `transform/opacity.value.v`: `text.set` replaces a text field, not a path inside a value"
   }
  },
  {
   "name": "no-such-field",
   "edit": {
    "ops": [
     {
      "op": "set",
      "target": "1",
