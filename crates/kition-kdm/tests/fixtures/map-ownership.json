      "edit": {
        "ops": [
          {
            "op": "text.set",
            "target": "p1",
            "field": "text",
            "text": "Changed"
          }
        ]
      },
      "expected": {
        "changed": [
          {
            "edits": [
              {
                "after": "Changed",
                "before": "A1",
                "field": "table.cells.r1:c1.body.paragraphs.0.text"
              }
            ],
            "fields": [
              "table.cells.r1:c1.body.paragraphs.0.text"
            ],
            "id": "shape:1",
            "type": "Shape"
          }
        ],
        "created": [],
        "deleted": [],
        "moved": []
      }
    },
    {
      "name": "cell-text-in-an-id-value",
      "intent": "A paragraph in the text body a cell's value is: told at `table.cells.<key>.paragraphs.0.text`.",
      "edit": {
        "ops": [
          {
            "op": "text.set",
            "target": "p2",
            "field": "text",
            "text": "Other"
          }
        ]
      },
      "expected": {
        "changed": [
          {
            "edits": [
              {
                "after": "Other",
                "before": "B1",
                "field": "table.cells.r1:c2.paragraphs.0.text"
              }
            ],
            "fields": [
              "table.cells.r1:c2.paragraphs.0.text"
            ],
            "id": "shape:1",
            "type": "Shape"
          }
        ],
        "created": [],
        "deleted": [],
        "moved": []
      }
    }
  ],
  "schemaErrors": [
