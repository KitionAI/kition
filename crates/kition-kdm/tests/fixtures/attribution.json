  "cases": [
    {
      "name": "text-inside-a-shape",
      "intent": "A paragraph's text changed: told as an edit of the shape holding it through its body, at `body.paragraphs.0.text`.",
      "edit": {
        "ops": [
          {
            "op": "text.set",
            "target": "p1",
            "field": "text",
            "text": "Hello there"
          }
        ]
      },
      "expected": {
        "changed": [
          {
            "edits": [
              {
                "after": "Hello there",
                "before": "Hello",
                "field": "body.paragraphs.0.text"
              }
            ],
            "fields": [
              "body.paragraphs.0.text"
            ],
            "id": "shape:1",
            "type": "Shape"
          }
        ],
        "created": [],
        "deleted": [],
        "moved": []
      },
      "texts": [
        {
          "id": "shape:1",
          "field": "body.paragraphs.0.text",
          "before": "Hello",
          "after": "Hello there"
        }
      ]
    },
