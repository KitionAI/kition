{
  "name": "kit-board-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Board kit's editor and engine (Kition Kit Standard 6.1): Kition's own board editor over the kit's TypeScript engine, embedded by hosts over the Kit UI protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "engine": "vite build --config vite.engine.config.ts",
    "sync": "node scripts/sync-kition.mjs",
    "dev": "node scripts/sync-kition.mjs && vite",
    "build": "node scripts/sync-kition.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/sample.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "loro-crdt": "1.16.4",
    "lucide-react": "^1.14.0",
    "radix-ui": "1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "^8.1.5"
  }
}
