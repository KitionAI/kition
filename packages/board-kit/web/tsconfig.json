{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "strict": false,
    "types": ["vite/client"],
    "paths": {
      "@kition/app-ui": ["../../app-ui/src/index.tsx"],
      "@kition/app-ui/*": ["../../app-ui/src/*"],
      "@kition/board-editor": ["../../board-editor/src/index.ts"],
      "@kition/board-editor/*": ["../../board-editor/src/*"],
      "@kition/kdm": ["../../../../kition-sdk/packages/kdm/src/index.ts"],
      "@kition/kit-engine": ["../../../../kition-sdk/packages/kit-engine/src/index.ts"],
      "@kition/kit-ui": ["../../../../kition-sdk/packages/kit-ui/src/index.ts"],
      "@kition/kit-protocol": ["../../../../kition-sdk/packages/kit-protocol/src/index.ts"],
      "@kition/kit-host": ["../../../../kition-sdk/packages/kit-host/src/index.ts"],
      "@kition/kit-dev-host": ["../../../../kition-sdk/packages/kit-dev-host/src/index.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["src"]
}
