{
  "name": "kit-document-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Document kit's editor and engine (Kition Kit Standard 6.1): Kition's own Markdown editor over the kit's TypeScript engine, embedded by hosts over the Kit UI protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "engine": "vite build --config vite.engine.config.ts",
    "sync": "node scripts/sync-kition.mjs",
    "dev": "node scripts/sync-kition.mjs && vite",
    "build": "node scripts/sync-kition.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/sample.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@uiw/react-codemirror": "^4.25.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dompurify": "3.4.13",
    "i18next": "^26.3.1",
    "katex": "^0.17.0",
    "loro-crdt": "1.16.4",
    "lucide-react": "^1.14.0",
    "marked": "^12.0.0",
    "mermaid": "^11.16.1",
    "radix-ui": "1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.4",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "^8.1.5"
  }
}
