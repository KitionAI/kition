{
  "kdm": 1,
  "kit": "kit.document",
  "schemaVersion": 2,
  "root": "Document",
  "types": {
    "Document": {
      "fields": {
        "body": { "kind": "text" }
      }
    },
    "CommentThread": {
      "fields": {
        "anchor": { "kind": "json" },
        "resolved": { "kind": "boolean", "optional": true },
        "comments": { "kind": "list", "of": "Comment" }
      }
    },
    "Comment": {
      "fields": {
        "author": { "kind": "string" },
        "name": { "kind": "string", "optional": true },
        "body": { "kind": "text" },
        "created": { "kind": "string" }
      }
    }
  }
}
